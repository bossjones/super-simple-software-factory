# SSSF environment. Copy to .env at the target repo root and fill in.

# Local development: prefer `copilot login` (or `gh auth login`) and leave
# token variables unset. The runtime checks token variables first, in this
# exact order:
#   1. COPILOT_GITHUB_TOKEN
#   2. GH_TOKEN
#   3. GITHUB_TOKEN
# Set at most one token variable; never configure more than one at a time.
# With no token variable, stored `copilot login` credentials take precedence
# over the `gh auth login` token fallback.
# COPILOT_GITHUB_TOKEN=
# GH_TOKEN=
# GITHUB_TOKEN=

# A local `.env` is accepted and ignored by git, but never commit credentials.
# Optional SDK/runtime overrides
# COPILOT_CLI_PATH=
# COPILOT_HOME=
# ENGINEER_NAME=
